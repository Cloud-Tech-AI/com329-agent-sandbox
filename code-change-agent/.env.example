# Copy to .env and fill in. .env is never copied into the image.
AWS_REGION=us-east-1
MODEL_ID=global.anthropic.claude-sonnet-4-6

# GitHub personal access token with repo scope (classic PAT, or fine-grained with
# Contents + Pull requests write access on the target repo)
GITHUB_TOKEN=ghp-xxxx
GITHUB_API_URL=https://api.github.com

# Optional static AWS credentials, copied into the cluster Secret by scripts/deploy.sh.
# Leave unset on EKS to use the pod's IAM role. AWS_PROFILE is not copied.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
